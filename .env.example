# Copy this file to .env and fill in what you need. Everything is optional for local use.

PORT=3000
# Set to production when deploying (makes the login cookie HTTPS-only).
NODE_ENV=development
# Public address of the site (e.g. https://badiaboutique.example), used for Stripe return links.
# Leave blank locally: it defaults to the address in your browser.
PUBLIC_URL=

# Payments. Leave blank to use test mode (orders are marked paid instantly).
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# Storage locations (defaults: ./data/thriftline.db and ./uploads)
DB_FILE=
UPLOAD_DIR=

# Demo sellers and listings: created automatically in development, never in production.
# Set to true or false to override. Before launch, run: npm run remove-demo
SEED_DEMO=
# Production redirects HTTP to HTTPS. Set to false only if your host already does this and you get a redirect loop.
FORCE_HTTPS=
